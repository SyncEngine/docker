# Copy this file to .env and adjust as needed.
# All values shown here are the defaults used when a variable is not set.

# Application environment: prod or dev.
# dev installs dev dependencies and disables opcache — requires a rebuild.
APP_ENV=prod
APP_DEBUG=0

# Host port the web UI is exposed on (http://localhost:<HTTP_PORT>)
HTTP_PORT=8080

# Pin a SyncEngine release for reproducible builds, e.g. v1.0.0.
# "latest" builds the newest release (build-time setting — requires a rebuild).
SYNCENGINE_VERSION=latest

# Symfony application secret (CSRF tokens, signed URLs, ...).
# Leave empty to auto-generate one on first start; it is persisted in the
# secrets volume so it survives container recreation.
APP_SECRET=

# Database connection. The default is a SQLite file stored in the db_data volume.
# To use MySQL/MariaDB instead:
#   DATABASE_URL=mysql://user:password@db-host:3306/syncengine?serverVersion=8&charset=utf8mb4
DATABASE_URL=sqlite:////app/var/data/data.db

# Mail transport, see https://symfony.com/doc/current/mailer.html#using-built-in-transports
# e.g. MAILER_DSN=smtp://user:pass@smtp.example.com:587
MAILER_DSN=sendmail://default

# Run pending database migrations automatically when the php container starts
RUN_MIGRATIONS=1

# Container timezone
TZ=UTC
